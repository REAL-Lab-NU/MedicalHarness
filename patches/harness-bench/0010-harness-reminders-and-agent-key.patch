+_HARNESS_REMINDER = re.compile(r"<system-reminder>.*?</system-reminder>\s*", re.S)
+
+
+def _strip_harness_reminders(text: str) -> str:
+    """Drop the ``<system-reminder>`` blocks Claude Code splices into user turns.
+
+    The extractor already discards ``role: "system"`` for every harness because
+    a system prompt is scaffold text, not agent behaviour. Claude Code carries
+    part of its scaffold text inside the *user* turn instead, as one or more
+    ``<system-reminder>`` blocks prepended to the task prompt. Left in, a
+    575-character reminder about commit attribution sits at the head of the
+    task message, and the per-message elision the judge payload applies (head
+    plus tail) then shows the judge the reminder and the answer-format footer
+    while the question itself is what gets cut. Codex puts its equivalent
+    (``<environment_context>``) in its own message, so its task prompt survives
+    intact; the same policy has to apply to both for the judge to be reading
+    the same thing.
+    """
+    return _HARNESS_REMINDER.sub("", text) if "<system-reminder>" in text else text
+
