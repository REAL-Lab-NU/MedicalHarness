     return 1.0, "security default 1 (missing security_gate in output)"
 
 
+def _elide(text: str, limit: int) -> str:
+    """Keep both ends of a long string; the middle is what a process judge needs least."""
+    if len(text) <= limit:
+        return text
+    head = limit * 2 // 3
+    tail = limit - head
+    return f"{text[:head]}\n…[{len(text) - limit:,} chars elided]…\n{text[-tail:]}"
+
+
+def _condense_trace(trace: dict[str, Any], *, per_message: int = 1200,
+                    transcript: int = 20000) -> dict[str, Any]:
+    """Shrink a trace so the WHOLE run survives the payload cap.
+
+    A single tool result can be enormous -- one session of a longitudinal chart is ~36k characters, a
+    directory listing can be ~100k -- and a flat prefix cut then feeds the judge the opening of the run
+    and nothing else, so a clean episode reads as one that never finished. The judge scores *process*:
+    which tools were called, in what order, whether the run recovered and landed. It needs every round,
+    not the full text of any one of them. So cap each message body and keep the structure intact.
+    """
+    out = dict(trace)
+    rounds = []
+    for r in trace.get("rounds") or []:
+        rr = dict(r)
+        msgs = []
+        for m in r.get("new_messages") or r.get("request_messages") or []:
+            mm = dict(m)
+            content = mm.get("content")
+            if isinstance(content, str):
+                mm["content"] = _elide(content, per_message)
+            msgs.append(mm)
+        if "new_messages" in rr:
+            rr["new_messages"] = msgs
+        elif "request_messages" in rr:
+            rr["request_messages"] = msgs
+        if isinstance(rr.get("assistant_text"), str):
+            rr["assistant_text"] = _elide(rr["assistant_text"], per_message)
+        rounds.append(rr)
+    if rounds:
+        out["rounds"] = rounds
+    ut = out.get("unified_transcript")
+    if isinstance(ut, str):
+        out["unified_transcript"] = _elide(ut, transcript)
+    elif isinstance(ut, list):
+        # a list of {role, content, ...}; one tool result here can be a whole 36k-char chart session
+        condensed = []
+        for m in ut:
+            if isinstance(m, dict) and isinstance(m.get("content"), str):
+                m = {**m, "content": _elide(m["content"], per_message)}
+            condensed.append(m)
+        out["unified_transcript"] = condensed
+    return out
+
+
