+def _route_codex_providers_through_proxy(config_path: Path, proxy_base_url: str,
+                                         proxy_routes_file: Path) -> None:
+    """Point every `[model_providers.<id>].base_url` at the usage proxy.
+
+    This adapter reconstructs a trace from Codex's own session log, which is enough for token
+    accounting but leaves the HTTP path untouched — so the sampling pins the other harnesses get
+    (HB_PIN_TEMPERATURE / TOP_P / SEED, injected by the proxy) would never reach the model, and this
+    row would be the only one running at whatever the server defaults to. Rewriting the base_url puts
+    Codex on the same footing as everything else.
+    """
+    if not config_path.is_file() or not proxy_base_url:
+        return
+    text = config_path.read_text(encoding="utf-8")
+    routes: dict[str, dict[str, str]] = {}
+    for match in re.finditer(r"(?ms)^\[model_providers\.([^\]]+)\]\n(.*?)(?=^\[|\Z)", text):
+        provider, block = match.group(1), match.group(0)
+        url_match = re.search(r'(?m)^base_url\s*=\s*"([^"]+)"', block)
+        if not url_match:
+            continue
+        upstream = url_match.group(1).rstrip("/")
+        if upstream.startswith(proxy_base_url.rstrip("/")):
+            continue
+        prefix = f"/codex/{re.sub(r'[^A-Za-z0-9_.-]+', '-', provider)}"
+        routes[prefix] = {"framework": "codex", "provider": provider, "upstream": upstream}
+        new_block = block.replace(url_match.group(0), f'base_url = "{proxy_base_url}{prefix}"')
+        text = text.replace(block, new_block)
+    if routes:
+        register_routes(proxy_routes_file, routes)
+        config_path.write_text(text, encoding="utf-8")
+
