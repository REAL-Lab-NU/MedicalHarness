+def _rewrite_provider_uris(text: str, data: dict, *, proxy_base_url: str,
+                           proxy_routes_file: Path) -> str:
+    """Route `[providers.models.<type>.<alias>].uri` through the usage proxy.
+
+    ZeroClaw 0.8 moved from a single top-level `default_provider = "custom:<url>"` to a table per
+    provider alias. Only the old form was rewritten here, so a 0.8 config talked to the upstream
+    directly and the run came back with no usage at all.
+    """
+    models = ((data.get("providers") or {}).get("models") or {})
+    if not isinstance(models, dict):
+        return text
+    routes: dict[str, dict[str, str]] = {}
+    for family, aliases in models.items():
+        if not isinstance(aliases, dict):
+            continue
+        for alias, entry in aliases.items():
+            if not isinstance(entry, dict):
+                continue
+            upstream = str(entry.get("uri") or "").strip().rstrip("/")
+            if not upstream or upstream.startswith(proxy_base_url.rstrip("/")):
+                continue
+            route_prefix = f"/zeroclaw/{_safe_name(str(family))}-{_safe_name(str(alias))}"
+            routes[route_prefix] = {
+                "framework": "zeroclaw",
+                "provider": f"{family}.{alias}",
+                "upstream": upstream,
+            }
+            section = re.compile(
+                r"(?ms)^\[providers\.models\." + re.escape(str(family)) + r"\." + re.escape(str(alias))
+                + r"\]\n(.*?)(?=^\[|\Z)")
+            match = section.search(text)
+            if not match:
+                continue
+            block = match.group(0)
+            new_block = re.sub(r'(?m)^uri\s*=\s*".*?"$',
+                               f'uri = "{proxy_base_url}{route_prefix}"', block)
+            text = text[: match.start()] + new_block + text[match.end():]
+    if routes:
+        register_routes(proxy_routes_file, routes)
+    return text
+
+
+def _safe_name(value: str) -> str:
+    return re.sub(r"[^A-Za-z0-9_.-]+", "-", value).strip("-") or "x"
