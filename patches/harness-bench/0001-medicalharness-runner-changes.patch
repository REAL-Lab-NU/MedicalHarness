+def _pin_sampling(body: bytes) -> bytes:
+    """Force sampling parameters onto an outbound completion request.
+
+    Product harnesses do not all expose temperature/seed (OpenClaw exposes neither), so one run of one
+    is a single draw from whatever the server happens to default to. Setting HB_PIN_TEMPERATURE /
+    HB_PIN_TOP_P / HB_PIN_SEED makes a run reproducible: same seed, same numbers. Vary only the seed
+    across repeats to measure spread. Values the harness set itself are left alone -- this fills gaps,
+    it does not overrule a harness that made its own choice. Unset env vars mean "change nothing".
+    """
+    pins = {
+        "temperature": os.environ.get("HB_PIN_TEMPERATURE"),
+        "top_p": os.environ.get("HB_PIN_TOP_P"),
+        "seed": os.environ.get("HB_PIN_SEED"),
+    }
+    if not any(pins.values()):
+        return body
+    try:
+        payload = json.loads(body)
+    except (ValueError, UnicodeDecodeError):
+        return body
+    if not isinstance(payload, dict) or "messages" not in payload:
+        return body
+    for key, raw in pins.items():
+        if raw is None or key in payload:
+            continue
+        payload[key] = int(raw) if key == "seed" else float(raw)
+    return json.dumps(payload).encode("utf-8")
+
