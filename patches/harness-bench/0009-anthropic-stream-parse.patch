+def _parse_anthropic_message(response_json: dict[str, Any]) -> tuple[str, list[dict[str, Any]]]:
+    """A non-streamed ``/v1/messages`` reply: text blocks and ``tool_use`` blocks."""
+    text_parts: list[str] = []
+    tool_calls: list[dict[str, Any]] = []
+    for block in response_json.get("content") or []:
+        if not isinstance(block, dict):
+            continue
+        if block.get("type") == "text" and isinstance(block.get("text"), str):
+            text_parts.append(block["text"])
+        elif block.get("type") == "tool_use":
+            args = block.get("input")
+            tool_calls.append({"name": str(block.get("name", "") or ""),
+                               "arguments": args if isinstance(args, dict) else str(args or "")})
+    return "".join(text_parts), tool_calls
+
+
+def _is_anthropic_message(obj: Any) -> bool:
+    return isinstance(obj, dict) and obj.get("type") == "message" and isinstance(obj.get("content"), list)
+
