+def _anthropic_stream_event(event: dict[str, Any], buffers: dict[int, dict[str, Any]],
+                            assistant_parts: list[str]) -> None:
+    """Fold one ``/v1/messages`` stream event into the same buffers the OpenAI path fills.
+
+    An Anthropic stream has no ``choices``: text arrives as ``content_block_delta``
+    events of type ``text_delta`` and a tool call as a ``content_block_start`` naming
+    the tool, followed by ``input_json_delta`` fragments of its arguments, all keyed
+    by content-block ``index``. Before this the parser read only ``choices[0].delta``,
+    so every round of a Claude Code episode yielded an empty assistant text and no
+    tool calls; the process judge then saw bare tool results with nothing that
+    called them and scored whatever visible prose the model happened to add --
+    zero for a model that emits none, a fraction for a chattier one. That is a
+    property of verbosity, not of process, and it is why the same episodes carried
+    the block's best outcome and a process score of 0.
+    """
+    kind = event.get("type")
+    if kind == "content_block_start":
+        block = event.get("content_block")
+        if isinstance(block, dict) and block.get("type") == "tool_use":
+            idx = int(event.get("index", 0))
+            buf = buffers.setdefault(idx, {"name": "", "arguments": ""})
+            buf["name"] = str(block.get("name", "") or "")
+            # A non-streamed argument object can ride along on the start event.
+            if isinstance(block.get("input"), dict) and block["input"]:
+                buf["arguments"] = json.dumps(block["input"], ensure_ascii=False)
+    elif kind == "content_block_delta":
+        delta = event.get("delta")
+        if not isinstance(delta, dict):
+            return
+        if delta.get("type") == "text_delta":
+            text = delta.get("text")
+            if isinstance(text, str) and text:
+                assistant_parts.append(text)
+        elif delta.get("type") == "input_json_delta":
+            idx = int(event.get("index", 0))
+            buf = buffers.setdefault(idx, {"name": "", "arguments": ""})
+            buf["arguments"] = str(buf["arguments"]) + str(delta.get("partial_json", "") or "")
+
+
