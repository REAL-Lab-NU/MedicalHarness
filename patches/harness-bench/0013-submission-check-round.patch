+# ---------------------------------------------------------------------------
+# Submission check (HB_SUBMISSION_CHECK=1): a deterministic artifact check with
+# one follow-up round. The task prompt names the files an answer must be written
+# to ("$WORKSPACE/out/answer.txt", "$WORKSPACE/submission/x.csv"); when the last
+# prompt round ends without one of them, the harness session is resumed once with
+# a short reminder. Off by default so recorded studies are unchanged; the outcome
+# of the check is written to the adapter result metadata either way.
+# ---------------------------------------------------------------------------
+_SUBMISSION_PATH_RE = re.compile(r"\$WORKSPACE/((?:out|submission)/[\w.\-]+(?:/[\w.\-]+)*)")
+
+
+def expected_submissions(task: TaskSpec, prompt_names: list[str]) -> list[str]:
+    """Workspace-relative files the prompts ask the agent to write, in prompt order, deduplicated."""
+    assert task.task_dir is not None
+    seen: list[str] = []
+    for name in prompt_names:
+        text = (task.task_dir / name).read_text(encoding="utf-8")
+        for rel in _SUBMISSION_PATH_RE.findall(text):
+            if rel not in seen:
+                seen.append(rel)
+    return seen
+
+
+def missing_submissions(workspace: Path, expected: list[str]) -> list[str]:
+    return [rel for rel in expected
+            if not (workspace / rel).is_file() or (workspace / rel).stat().st_size == 0]
+
+
+def submission_reminder(workspace: Path, missing: list[str]) -> str:
+    listed = "\n".join(f"  {workspace / rel}" for rel in missing)
+    return ("Submission check: the task requires the following file(s), which do not exist or are empty:\n"
+            f"{listed}\n"
+            "Write your final answer to each of them now, in exactly the format the task specified. "
+            "Do not start the task over and do not do anything else.")
+
+
 def render_prompt_file(task: TaskSpec, prompt_name: str, workspace: Path, runtime_env: dict[str, str], adapter_name) -> str:
     assert task.task_dir is not None
     prompt_template = (task.task_dir / prompt_name).read_text(encoding="utf-8")
