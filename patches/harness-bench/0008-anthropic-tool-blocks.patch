+def _split_anthropic_blocks(content: Any) -> tuple[str, list[dict[str, Any]]]:
+    """Separate an Anthropic content list into its text and its tool results.
+
+    In the OpenAI shapes a tool result arrives as its own ``role: "tool"``
+    message, which this extractor keeps. Anthropic's ``/v1/messages`` instead
+    carries it as a ``tool_result`` block inside the *user* turn, and
+    ``_normalize_content`` keeps only blocks with a ``text`` key, so every tool
+    result used to vanish and the turn collapsed to an empty string. The
+    process judge then saw a run with no tool use at all and scored every
+    dimension zero, on every benchmark, for any harness speaking that protocol.
+
+    Returning the results separately lets the caller re-emit them as
+    ``role: "tool"`` messages, which is the same view the OpenAI path already
+    produces. ``tool_use`` blocks are deliberately not rendered into the
+    assistant text: the OpenAI path drops the assistant's ``tool_calls`` from
+    the request messages too, and the two protocols have to reach the judge
+    looking alike or the comparison measures the extractor.
+    """
+    if not isinstance(content, list):
+        return _normalize_content(content), []
+    text_parts: list[str] = []
+    results: list[dict[str, Any]] = []
+    for part in content:
+        if isinstance(part, str):
+            text_parts.append(part)
+            continue
+        if not isinstance(part, dict):
+            continue
+        kind = part.get("type")
+        if kind == "tool_result":
+            results.append(part)
+        elif kind == "tool_use":
+            continue
+        elif kind == "text" and "text" in part:
+            text_parts.append(str(part["text"]))
+        elif "text" in part:
+            text_parts.append(str(part["text"]))
+    return "\n".join(text_parts), results
+
